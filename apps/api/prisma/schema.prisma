// ─────────────────────────────────────────────────────────────────────────────
// Schéma Prisma — SaaS Événementiel & Billetterie
// Référence : CDC v2.0.0 — section 5
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  // "native" pour le dev natif hors Docker (Windows/macOS/glibc) ; l'image
  // node:20-alpine (Docker) est musl + OpenSSL 3.x — sans ce binaryTarget
  // explicite, Prisma génère par défaut un moteur linux-musl lié à OpenSSL
  // 1.1, absent des images Alpine récentes (bug réel rencontré : "Error
  // loading shared library libssl.so.1.1: No such file or directory").
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// UTILISATEURS & AUTH
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  avatarUrl           String?
  googleId            String?   @unique
  role                Role      @default(CLIENT)
  /// Rôle d'avant une promotion en scanner (2026-08-19). Un utilisateur n'a
  /// qu'un rôle : promouvoir un client le fait passer en SCANNER et lui fait
  /// perdre l'accès à ses propres billets. On garde d'où il vient pour
  /// pouvoir le lui rendre en le retirant.
  previousRole        Role?
  isActive            Boolean   @default(true)
  /// Compte créé à la volée pour un achat sans compte (lot 1, 2026-08-22).
  /// Le visiteur ne le voit jamais : ni mot de passe, ni connexion, ni page
  /// « Mon billet ». Il existe pour que la commande ait un propriétaire —
  /// `Order.clientId` est obligatoire, et le scan, l'export, la rétention et
  /// les remboursements en dépendent tous.
  ///
  /// Si la personne se connecte plus tard avec la même adresse, elle retrouve
  /// ses billets : le compte cesse alors d'être fantôme.
  isGuest             Boolean   @default(false)
  /// Palier d’abonnement (2026-08-21) — remplace `isPremium`, qui ne
  /// commandait que le multi-jours et aurait fini par porter quatre
  /// privilèges sans les nommer. Voir `LIMITES_PLAN` (packages/types).
  plan                SubscriptionPlan @default(FREE)
  // Enrichi post-paiement via webhook provider (jamais écrasé si déjà renseigné)
  phone               String?
  country             String?
  profileCompletedAt  DateTime?

  // Vérification obligatoire du téléphone par code WhatsApp (décision produit
  // 2026-07-15) — Manager et Client uniquement, bloque le workflow tant que
  // non vérifié (PhoneVerificationGate côté frontend). `phone` peut donc être
  // renseigné (en attente de vérification) sans que `phoneVerifiedAt` soit posé —
  // soumettre un nouveau numéro invalide toujours la vérification précédente.
  phoneVerifiedAt                DateTime?
  phoneVerificationCode          String?
  phoneVerificationCodeExpiresAt DateTime?
  passwordHash        String? // Scanners uniquement, et Managers invités par email (login email/password)
  /// Numero de version des jetons (2026-08-23). Voyage dans le JWT et se
  /// compare a celui du compte : l incrementer invalide d un coup tous les
  /// jetons deja emis, sans liste de revocation a tenir.
  ///
  /// Un jeton emis avant cette colonne ne porte pas de version : il est lu
  /// comme la version 0, donc encore valable.
  tokenVersion        Int     @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Invitation Manager par email (Admin) — décision produit 2026-07-14. Le
  // compte existe avec passwordHash=null jusqu'à ce que le lien reçu par
  // email soit utilisé pour définir un mot de passe (POST /api/auth/set-password).
  inviteToken          String?   @unique
  inviteTokenExpiresAt DateTime?

  /// Recuperation de mot de passe (2026-08-23).
  ///
  /// Stocke HACHE, contrairement a `inviteToken` : un jeton de
  /// reinitialisation vaut un mot de passe, il se range comme un mot de
  /// passe. Le jeton remis a l utilisateur porte l identifiant du compte en
  /// prefixe, ce qui evite d avoir a chercher par le hachage.
  passwordResetTokenHash      String?
  /// Une heure. Sert aussi de garde-fou : tant qu un jeton valide existe, on
  /// n en emet pas un second.
  passwordResetTokenExpiresAt DateTime?
  /// Date de la DEMANDE, distincte de l expiration : deduire l une de l autre
  /// deviendrait faux le jour ou la duree de vie changerait.
  passwordResetRequestedAt    DateTime?

  // Inscription self-service Manager via Google depuis la page d'accueil
  // (décision produit 2026-07-14) — distinct d'un Manager créé par
  // invitation Admin. Seuls ces comptes sont concernés par la suppression
  // automatique après 3 jours sans abonnement (voir AccountRetentionService) ;
  // jamais un compte créé par un Admin ou par le script de seed.
  isSelfService      Boolean @default(false)
  // Statut géré manuellement par l'Admin (pas de facturation récurrente réelle
  // en V1, décision produit 2026-07-14) — un Manager invité par l'Admin démarre
  // abonné (l'Admin l'a déjà vérifié) ; un Manager self-service démarre non
  // abonné (fenêtre d'essai de 3 jours avant suppression automatique).
  subscriptionActive Boolean @default(false)

  managedEvents  Event[]  @relation("EventManager")
  scannerProfile Scanner?
  orders         Order[]
  auditLogs      AuditLog[]

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  MANAGER
  SCANNER
  CLIENT
}

// ─────────────────────────────────────────────────────────────────────────────
// ÉVÉNEMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Event {
  id                       String              @id @default(cuid())
  slug                     String              @unique
  title                    String
  description              String?
  coverImageUrl            String?
  /// Adresse libre historique — conservée telle quelle : elle alimente le hero
  /// et le pied de page, et sert de repli tant que les champs structurés
  /// ci-dessous sont vides (sinon les événements existants perdraient leur
  /// adresse à la migration).
  location                 String?

  // Localisation structurée (décision produit 2026-08-16) — alimente le bloc
  // `location` de la page publique. Pas de carte intégrée : le lien « Ouvrir
  // dans Maps » se construit depuis ces champs, sans clé d’API ni tiers
  // chargé chez le visiteur.
  venueName                String?
  addressLine              String?
  city                     String?
  country                  String?
  /// Indications d’accès : étage, parking, repère visuel, consignes d’entrée.
  accessNotes              String?
  /// Coordonnées optionnelles — si présentes, le lien Maps les préfère à
  /// l’adresse (plus fiable qu’un géocodage approximatif).
  /// Affiche officielle — image OU vidéo — mise en avant dans la colonne
  /// droite du hero (2026-08-19). Distincte de `coverImageUrl`, qui n'est
  /// qu'une vignette de partage : celle-ci est le visuel que l'organisateur
  /// veut voir en grand, à son format réel. Vide, le hero retombe sur la
  /// couverture.
  officialMediaUrl         String?
  /// Fond du hero, flouté et assombri derrière le texte (2026-08-19).
  /// Vide, c'est l'affiche officielle qui sert de fond — comportement
  /// d'origine. Le champ existe pour les affiches trop chargées, qui
  /// rendent le titre illisible même floutées.
  heroBackdropUrl          String?
  /// Format d'affichage de ce média : '4:5', '1:1' ou '9:16'.
  officialMediaAspect      String?
  latitude                 Decimal? @db.Decimal(9, 6)
  longitude                Decimal? @db.Decimal(9, 6)
  /// Numéro officiel de l’événement, affiché publiquement (E.164).
  contactPhone             String?
  /// Nombre de personnes prévues — PLAFOND RÉEL (décision produit 2026-08-16) :
  /// la somme des `stock` de tous les billets ne peut pas le dépasser, refusé
  /// à la création comme à la modification d’un billet. null = aucun plafond.
  expectedAttendees        Int?
  /// Régime de billetterie (décision produit 2026-08-16). Reste SINGLE_DAY
  /// tant que le Manager n’est pas Premium — c’est le comportement d’avant.
  ticketPolicy             TicketPolicy @default(SINGLE_DAY)

  /// Régime d’accès (plan 2026-08-21) : inscription simple, billetterie
  /// sans compte, ou billetterie avec compte. Le défaut reproduit le
  /// comportement historique — aucun événement existant ne bouge à la
  /// migration.
  accessMode               EventAccessMode @default(TICKETED_ACCOUNT)

  startDate                DateTime
  endDate                  DateTime // Détermine la durée de session client (endDate + 24h)
  timezone                 String              @default("Africa/Abidjan")
  status                   EventStatus         @default(DRAFT)
  /// Plafond d’agents de contrôle. `null` = suivre le palier du manager
  /// (3 en FREE, 6 en PREMIUM). Une valeur explicite est une dérogation
  /// accordée par l'Admin — un festival qui a besoin de douze agents sans
  /// qu’on touche à l’offre.
  ///
  /// ⚠️ Ce champ ne limitait RIEN avant le 2026-08-21 : il valait 3 partout
  /// et personne ne le lisait. Le contrôle vit désormais dans
  /// `ScannerAdminService`.
  maxScanners              Int?
  paymentProvider          PaymentProviderType?
  allowManagerChooseProvider Boolean          @default(true)
  expiresAt                DateTime?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  // Contenu centralisé de l'événement (décision produit 2026-07-13) — édité
  // depuis l'onglet "Config" du Builder, consommé par les blocs de placement
  // correspondants (faq/schedule/speakers/gallery/sponsors) : un seul jeu de
  // contenu par événement, pas un contenu dupliqué par instance de bloc.
  logoUrl        String?
  faqs           Json    @default("[]") // FaqEntry[] — max 5, validé par UpdateEventDto
  schedule       Json    @default("[]") // ScheduleEntry[] — "Programme"
  speakers       Json    @default("[]") // SpeakerEntry[]
  galleryImages  Json    @default("[]") // MediaEntry[]
  sponsorImages  Json    @default("[]") // MediaEntry[] — carrousel infini

  /// Un manager portait UN événement (contrainte V1, CDC §1.4). Le palier
  /// Premium en autorise huit (2026-08-21) : le `@unique` saute, le quota
  /// est appliqué à la création par `LIMITES_PLAN`. Retirer une contrainte
  /// d'unicité ne déplace aucune donnée ; tout le reste du schéma était déjà
  /// rattaché à `eventId`.
  managerId String
  manager   User   @relation("EventManager", fields: [managerId], references: [id])

  @@index([managerId])

  tickets   Ticket[]
  days      EventDay[]
  orders    Order[]
  scanners  Scanner[]
  eventPage EventPage?
  registrations Registration[]
  analytics EventAnalytics?
  paymentProviderConfigs PaymentProviderConfig[]
  registrationForm       RegistrationForm?

  @@map("events")
}

/// Palier d’abonnement du Manager. Distinct de `subscriptionActive`, qui
/// commande la rétention et vaut déjà `true` pour tout manager invité.
/// Régime d’accès d’un événement — voir `EventAccessMode` (packages/types).
enum EventAccessMode {
  RSVP
  TICKETED_GUEST
  TICKETED_ACCOUNT
}

enum SubscriptionPlan {
  FREE
  PREMIUM
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  EXPIRED
}

// ─────────────────────────────────────────────────────────────────────────────
// PAGE BUILDER
// ─────────────────────────────────────────────────────────────────────────────

model EventPage {
  id          String   @id @default(cuid())
  eventId     String   @unique
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  blocks      Json     @default("[]") // Validé par BlocksArraySchema (Zod) avant écriture
  theme       Json     @default("{}")
  isPublished Boolean  @default(false)
  publishedAt DateTime?
  // Verrou optimiste — contrôle de concurrence (CDC §11.3)
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("event_pages")
}

// ─────────────────────────────────────────────────────────────────────────────
// BILLETTERIE
// ─────────────────────────────────────────────────────────────────────────────

model Ticket {
  id              String   @id @default(cuid())
  eventId         String
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  // Prix barré affiché au-dessus de `price` quand > price (promo) — purement
  // d'affichage, ne change jamais le montant réellement facturé.
  compareAtPrice  Decimal? @db.Decimal(10, 2)
  // Fin de la réduction affichée (bandeau d'urgence) — distinct de
  // `saleEndDate` qui arrête la vente elle-même.
  promoEndsAt     DateTime?
  // Regroupement visuel par jour pour un événement multi-jours (ex: "Jour 1
  // — Samedi 8 Août"). Optionnel — laissé vide, comportement mono-jour inchangé.
  dayLabel        String?
  /// Journée ouverte par ce billet en régime PER_DAY. `null` en SINGLE_DAY et
  /// en PASS_ALL_DAYS (où le billet vaut pour toutes les journées). Ne pas
  /// confondre avec `dayLabel` ci-dessus, qui n’est que du texte d’affichage
  /// et que le scanner n’a jamais lu.
  eventDayId      String?
  eventDay        EventDay? @relation(fields: [eventDayId], references: [id], onDelete: SetNull)
  currency        String   @default("XOF")
  stock           Int // Capacité totale
  stockSold       Int      @default(0) // Décrémenté via updateMany atomique avec guard
  /// Plafond de places par commande. Sans rapport avec l'invariant « 1 billet
  /// = 1 QR = 1 personne » : une commande de N places émet N billets, donc N
  /// QR. Le défaut 1 est donc un plafond restrictif, pas une contrainte
  /// technique — le formulaire propose 10 à la création (2026-08-17).
  maxPerOrder     Int      @default(1)
  /// Rang d'affichage sur la page publique (« Pass individuel », « Pass
  /// groupe »…). Texte libre : c'est l'organisateur qui nomme ses familles de
  /// billets, pas nous. Vide = le billet s'affiche hors de tout rang.
  category        String?
  /// Bénéfices inclus, une ligne par entrée (« Accès Jour 1 », « Espace food
  /// & bar »…). Distinct de `description`, qui est une phrase de présentation :
  /// une liste se BALAIE pour comparer deux formules, un paragraphe se lit.
  /// (décision produit 2026-08-18)
  features        String[] @default([])
  /// Vente en ligne ou sur demande (2026-08-18). En ON_REQUEST, `price` reste
  /// un ORDRE DE GRANDEUR affiché : rien n'est encaissé par la plateforme, le
  /// montant réel se négocie hors ligne.
  saleMode        TicketSaleMode @default(ONLINE)
  /// Pastille de qualification affichée au-dessus d'une formule sur demande
  /// (« Sur réservation », « Groupe de 6 »…). Texte libre de l'organisateur.
  requestBadge    String?
  isActive        Boolean  @default(true)
  saleStartDate   DateTime?
  saleEndDate     DateTime?
  // Design billet (valeurs validées HEX/URL avant stockage)
  designImageUrl  String? // URL Supabase Storage bucket ticket-designs/ (whitélistée)
  designBgColor   String?  @default("#d4ac0d") // HEX strict uniquement
  designTextColor String?  @default("#333333") // HEX strict uniquement
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems OrderItem[]

  @@map("tickets")
}

// ─────────────────────────────────────────────────────────────────────────────
// COMMANDES & PAIEMENTS
// ─────────────────────────────────────────────────────────────────────────────

model Order {
  id              String             @id @default(cuid())
  orderNumber     String             @unique @default(cuid())
  eventId         String
  event           Event              @relation(fields: [eventId], references: [id])
  clientId        String
  client          User               @relation(fields: [clientId], references: [id])
  status          OrderStatus        @default(PENDING)
  totalAmount     Decimal            @db.Decimal(10, 2)
  currency        String             @default("XOF")
  paymentProvider PaymentProviderType
  paymentRef      String? // Référence provider
  paymentData     Json? // Payload webhook brut (audit)
  paidAt          DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  items OrderItem[]

  @@map("orders")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
  /// Abandonnee avant paiement (2026-09-02) : le stock reserve a ete rendu.
  ///
  /// Distinct de CANCELLED, qui suppose un geste. Ici personne n a rien
  /// fait -- et le tableau de bord doit pouvoir le dire.
  EXPIRED
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id])
  quantity    Int      @default(1) // V1 : toujours 1 (1 OrderItem = 1 QR)
  unitPrice   Decimal  @db.Decimal(10, 2)
  // Généré par BullMQ worker après confirmation paiement
  qrCode      String? // JWT signé HS256 avec exp = event.endDate + 24h
  qrCodeUrl   String? // URL PDF Supabase Storage
  isScanned   Boolean  @default(false)
  scannedAt   DateTime?
  scannedById String?
  createdAt   DateTime @default(now())

  /// Entrées jour par jour, uniquement en régime PASS_ALL_DAYS.
  dayScans    TicketDayScan[]

  @@map("order_items")
}

// ─────────────────────────────────────────────────────────────────────────────
// IDEMPOTENCE WEBHOOK
// Empêche le double-traitement d'un webhook rejoué par le provider (CDC §8.3)
// ─────────────────────────────────────────────────────────────────────────────

model WebhookEvent {
  id            String   @id @default(cuid())
  provider      String // "KKIAPAY" | "CINETPAY" | "FEDAPAY"
  transactionId String // ID unique côté provider
  processedAt   DateTime @default(now())

  // Garantit l'atomicité de l'idempotence → P2002 si doublon
  @@unique([provider, transactionId])
  @@map("webhook_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// SCANNERS
// ─────────────────────────────────────────────────────────────────────────────

model Scanner {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  logs ScannerLog[]

  @@map("scanners")
}

model ScannerLog {
  id          String     @id @default(cuid())
  scannerId   String
  scanner     Scanner    @relation(fields: [scannerId], references: [id])
  orderItemId String?
  result      ScanResult
  ip          String?
  userAgent   String?
  scannedAt   DateTime   @default(now())

  @@map("scanner_logs")
}

enum ScanResult {
  VALID
  ALREADY_USED
  EXPIRED
  INVALID
  EVENT_MISMATCH
  /// Billet authentique et payé, mais pas valable aujourd’hui (2026-08-16).
  WRONG_DAY
}

// ─────────────────────────────────────────────────────────────────────────────
// PAIEMENTS PROVIDERS
// ─────────────────────────────────────────────────────────────────────────────

// Config par événement (décision produit 2026-07-13 — supersede BUSINESS.md §6
// "un seul compte Kkiapay global" : chaque Admin configure désormais le
// fournisseur de paiement événement par événement ; 1 Manager = 1 Event en V1
// donc c'est de facto une config par Manager, assumé explicitement).
model PaymentProviderConfig {
  id            String              @id @default(cuid())
  eventId       String
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  provider      PaymentProviderType
  // Au plus une ligne isActive=true par événement (contrainte applicative,
  // PaymentsAdminService désactive les autres à l'activation d'une nouvelle).
  isActive      Boolean             @default(false)
  /// « Appliquer a tous mes evenements » (2026-08-24). Une config marquee
  /// globale est recopiee sur les evenements existants du manager et sur ceux
  /// qu il creera ensuite. La ligne reste portee par l evenement : la lecture
  /// du paiement cherche par eventId et n a pas a connaitre l heritage.
  isGlobal      Boolean             @default(false)
  publicKey     String?
  privateKey    String // Chiffré AES-256-GCM avant stockage
  webhookSecret String? // Chiffré AES-256-GCM avant stockage
  config        Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@unique([eventId, provider])
  @@map("payment_provider_configs")
}

/// Fournisseurs de PAIEMENT — ceux qui encaissent réellement.
///
/// ⚠️ Google Pay et Apple Pay n'y figurent pas, et c'est délibéré : ce sont
/// des portefeuilles qui présentent une carte, ils n’encaissent rien par
/// eux-mêmes. Stripe Checkout les affiche de lui-même selon le navigateur du
/// visiteur. Les inscrire ici aurait obligé à leur inventer des clés qui
/// n'existent pas, et fait apparaître dans l'espace Admin deux lignes que
/// personne ne peut remplir.
enum PaymentProviderType {
  KKIAPAY
  CINETPAY
  FEDAPAY
  STRIPE
  PAYPAL
}

// ─────────────────────────────────────────────────────────────────────────────
// INSCRIPTIONS (régime RSVP)
// ─────────────────────────────────────────────────────────────────────────────

/// Inscription à un événement sans billetterie (lot 2, 2026-08-22).
///
/// Table dédiée, sans User ni Order. La tentation était de créer un billet
/// gratuit et de réutiliser le tunnel : cela fabriquerait des commandes, des
/// QR et des PDF pour rien, et ferait apparaître des « ventes à 0 F » dans
/// l'analytique de l'organisateur.
model Registration {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  firstName String
  lastName  String
  email     String
  phone     String?

  /// Champ libre facultatif, nommé par l'organisateur (« Tu viens avec
  /// combien de personnes ? »). Le libellé est stocké AVEC la réponse : le
  /// changer plus tard ne doit pas réécrire le sens des réponses déjà
  /// recueillies.
  extraLabel String?
  extraValue String?

  createdAt DateTime @default(now())

  /// Pointage à l'entrée (2026-08-22). L'horodatage plutôt qu'un booléen :
  /// savoir QUAND quelqu'un est arrivé sert à l'organisateur, et distingue
  /// un pointage du soir même d’une case cochée trois jours plus tard.
  ///
  /// `null` = pas encore arrivé. Dépointer remet à null, car on se trompe de
  /// ligne sur un téléphone, debout, dans le bruit.
  checkedInAt DateTime?

  /// Reponses au questionnaire compose par l organisateur (2026-08-27).
  ///
  /// Chaque reponse embarque le libelle et le type de sa question, figes au
  /// moment ou elle est donnee : reformuler une question ne doit pas reecrire
  /// le sens des reponses deja recueillies.
  answers Json?

  /// Une adresse ne s'inscrit qu'une fois par événement. C'est le garde-fou
  /// principal contre le remplissage automatique du formulaire public.
  @@unique([eventId, email])
  @@index([eventId, createdAt])
  @@map("registrations")
}

// ─────────────────────────────────────────────────────────────────────────────
// ANALYTICS
// ─────────────────────────────────────────────────────────────────────────────

model RegistrationForm {
  id          String  @id @default(cuid())
  eventId     String  @unique
  event       Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Un questionnaire desactive garde sa definition ET ses reponses : on le
  /// remet en service sans rien ressaisir.
  isActive    Boolean @default(false)
  title       String?
  description String?
  /// ChampQuestionnaire[] -- voir packages/types/src/questionnaire.ts.
  fields      Json    @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("registration_forms")
}

model EventAnalytics {
  id              String   @id @default(cuid())
  eventId         String   @unique
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  totalRevenue    Decimal  @default(0) @db.Decimal(10, 2)
  ticketsSold     Int      @default(0)
  totalScans      Int      @default(0)
  uniqueAttendees Int      @default(0)
  conversionRate  Decimal  @default(0) @db.Decimal(5, 2)
  lastUpdatedAt   DateTime @default(now())

  @@map("event_analytics")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String // ex: "payment.webhook.success", "scan.valid"
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([action])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// BRANDING PLATEFORME
// ─────────────────────────────────────────────────────────────────────────────

// PlatformSettings — Ligne singleton (id fixe "singleton") pour la marque de
// la plateforme : logo SVG complet et icône SVG (favicon/repli compact),
// configurables par le Super Admin (page /admin/branding, 2026-07-17).
// Contenu déjà assaini (sanitize-html) à l'écriture — jamais de SVG brut
// non filtré en base (même principe que la whitelist d'URL d'image,
// RULES.md §6 : la BDD ne doit jamais contenir que du contenu déjà sûr).
model PlatformSettings {
  id        String   @id @default("singleton")
  logoSvg   String?  @db.Text
  iconSvg   String?  @db.Text

  /// Messagerie WhatsApp (Meta Cloud API) — réglable depuis l'espace Admin
  /// (2026-08-19). Ces valeurs ne vivaient qu'en variables d'environnement :
  /// changer de numéro ou de modèle approuvé imposait un accès au serveur et
  /// un redémarrage. Vides, le service retombe sur les variables
  /// d'environnement, donc rien ne casse pour une installation existante.
  ///
  /// Le jeton est chiffré AES-256-GCM comme les clés de paiement, et n'est
  /// JAMAIS renvoyé en clair par aucun endpoint (RULES.md §9).
  whatsappAccessToken       String? @db.Text
  whatsappPhoneNumberId     String?
  whatsappApiVersion        String?
  /// Modèles approuvés dans Meta Business Manager — Meta interdit le texte
  /// libre, seul un modèle validé part.
  whatsappTicketTemplate    String?
  whatsappTicketLang        String?
  whatsappVerifyTemplate    String?
  whatsappVerifyLang        String?

  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONTENU LANDING (CMS admin-configurable, 2026-07-22)
// ─────────────────────────────────────────────────────────────────────────────

// LandingSettings — Ligne singleton (même convention que PlatformSettings) :
// tout le contenu éditable de la landing publique en une seule ligne, lue en
// une requête. Les listes (features/roles/pricingPlans/blogPosts) sont des
// colonnes JSON plutôt que des tables relationnelles séparées — même pattern
// que Event.faqs/schedule/speakers (contenu structuré propre à un seul
// propriétaire, validé en class-validator à l'écriture, jamais de confiance
// aveugle au JSON stocké).
//
// LandingSettings retiré (2026-07-23, décision produit) : toute la landing
// est désormais éditée à la main (apps/web/lib/content/) — seuls les logos
// "confiance" restent pilotables depuis l'admin, via un simple dossier S3
// (trusted-logos/), pas de table dédiée.

/// Régime de billetterie d'un événement (décision produit 2026-08-16).
/// Le multi-jours est réservé aux Managers Premium ; un compte standard reste
/// en SINGLE_DAY, qui est exactement le comportement d'avant cette notion.
/// Comment ce billet se vend (décision produit 2026-08-18).
enum TicketSaleMode {
  /// Achat en ligne immédiat — comportement historique de tout billet.
  ONLINE
  /// Formule négociée (table, package groupe) : la page publique l'affiche et
  /// renvoie vers WhatsApp, l'API refuse de la mettre au panier. Sans elle,
  /// les organisateurs fabriquaient des billets fictifs qu'ils annulaient à la
  /// main après chaque demande.
  ON_REQUEST
}

enum TicketPolicy {
  /// Événement d'une seule journée — aucun `EventDay`, billet à usage unique.
  SINGLE_DAY
  /// Un billet vaut pour TOUS les jours : une entrée autorisée par jour, pas
  /// une seule au total. Le verrou d'unicité vit alors sur `TicketDayScan`.
  PASS_ALL_DAYS
  /// Chaque billet appartient à un jour précis et n'ouvre que celui-là.
  PER_DAY
}

/// Journée d'un événement multi-jours (décision produit 2026-08-16).
///
/// Une vraie table, et non un tableau JSON comme `faqs`/`speakers` : le
/// scanner valide contre ces lignes et les billets les référencent — un JSON
/// ne porte ni clé étrangère ni contrainte d'unicité.
model EventDay {
  id      String   @id @default(cuid())
  eventId String
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Libellé affiché ("Jour 1 — Samedi 8 Août"). Reprend `Ticket.dayLabel`,
  /// qui n'était qu'un texte décoratif sans existence propre.
  label   String
  /// Date civile de la journée, sans heure : le scanner compare une date du
  /// calendrier, pas un instant.
  date    DateTime @db.Date
  /// Lieu propre à cette journée (décision produit 2026-08-18) : un festival
  /// change souvent de scène d'un jour à l'autre. Vide = le lieu de
  /// l'événement s'applique — on ne duplique pas ce qui ne varie pas.
  location  String?
  /// Heures civiles « HH:mm », comme la date juste au-dessus est une date
  /// civile : la journée se tient à 20h SUR PLACE, pas à un instant UTC. Un
  /// DateTime rouvrirait l'ambiguïté de fuseau que @db.Date ferme ici.
  startTime String?
  endTime   String?
  /// Coordonnées de CETTE journée (2026-08-18). Deux cas produit :
  ///  - une tournée change de salle d'une date à l'autre : chaque journée
  ///    porte les siennes, la carte affiche un point par lieu ;
  ///  - une formation se tient toujours au même endroit : on les laisse
  ///    vides, celles de l'événement s'appliquent et la carte n'a qu'un point.
  /// Même précision que Event.latitude/longitude.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)
  order   Int      @default(0)

  tickets Ticket[]
  scans   TicketDayScan[]

  /// Deux journées d'un même événement ne peuvent pas tomber le même jour —
  /// sinon le scanner ne saurait pas laquelle « aujourd'hui » désigne.
  @@unique([eventId, date])
  @@map("event_days")
}

/// Entrée d'un porteur de pass pour une journée donnée (décision produit
/// 2026-08-16).
///
/// Existe uniquement pour PASS_ALL_DAYS, où le booléen `OrderItem.isScanned`
/// ne suffit plus : il faut autoriser une entrée PAR JOUR sans rouvrir la
/// porte au double scan dans la même journée. C'est l'index unique
/// `(orderItemId, eventDayId)` qui tient ce rôle — la même garantie atomique
/// que l'`updateMany` gardé du régime mono-jour, déléguée à PostgreSQL.
model TicketDayScan {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  eventDayId  String
  eventDay    EventDay  @relation(fields: [eventDayId], references: [id], onDelete: Cascade)
  scannedAt   DateTime  @default(now())
  scannedById String?

  @@unique([orderItemId, eventDayId])
  @@map("ticket_day_scans")
}
