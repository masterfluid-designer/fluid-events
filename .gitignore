# Dépendances
node_modules/
.pnp
.pnp.js

# Build
dist/
build/
.next/
out/
*.tsbuildinfo

# Turbo / cache
.turbo/
.turbo-cache/

# Tests / coverage
coverage/
*.lcov
apps/web/test-results/
apps/web/playwright-report/
apps/web/blob-report/
apps/web/.last-run.json

# Variables d'environnement (ne jamais committer les vraies valeurs)
.env
.env.local
.env.*.local
apps/*/.env
apps/*/.env.local
!**/.env.example

# Prisma
apps/api/prisma/migrations/dev.db
apps/api/prisma/*.db-journal

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
*.swp
*.swo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Sources de polices : seuls les .woff2 sont versionnés (18 Mo contre 152 Mo,
# et c'est le seul format que servent les navigateurs). Les .ttf d'origine
# restent sur disque pour pouvoir reconvertir, sans peser dans l'historique.
apps/web/fonts/**/*.ttf
apps/web/fonts/**/OFL.txt
apps/web/fonts/**/README.txt

# Build de vérification, à côté du .next du serveur de dev (2026-08-21)
.next-verif/
